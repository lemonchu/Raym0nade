#version 460
#extension GL_EXT_ray_query : require

#include "include/packed_scene.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 5, std430) writeonly buffer OutputBuffer {
    vec4 pixels[];
} outputBuffer;

layout(push_constant, std430) uniform RenderParameters {
    vec4 cameraPositionAndPixelScale;
    vec4 cameraDirectionAndRayMinimum;
    vec4 cameraUpAndUnused;
    vec4 cameraRightAndUnused;
    uvec4 extentAovAndReserved;
    vec4 directionToLightAndUnused;
    vec4 incidentRadianceAndUnused;
} parameters;

const uint primaryAovBaseColor = 0U;
const uint primaryAovShapeNormal = 1U;
const uint primaryAovDirectDiffuse = 2U;
const float positionDifferentialDenominatorMinimum = 1.0e-8;
const float rayDifferentialLengthMinimum = 1.0e-12;

float primaryTextureFootprint(
    uint primitiveId,
    float hitDistance,
    vec3 unnormalizedDirection,
    vec3 rayDirection,
    vec3 shapeNormal) {
    const vec3 directionDx =
        parameters.cameraPositionAndPixelScale.w *
        parameters.cameraRightAndUnused.xyz;
    const vec3 directionDy =
        parameters.cameraPositionAndPixelScale.w *
        parameters.cameraUpAndUnused.xyz;
    const float squaredLength =
        dot(unnormalizedDirection, unnormalizedDirection);
    if (!(squaredLength > rayDifferentialLengthMinimum) ||
        !isFiniteScalar(squaredLength)) {
        return 0.0;
    }
    const float denominator = sqrt(squaredLength) * squaredLength;
    const vec3 rayDirectionDx =
        (squaredLength * directionDx -
         unnormalizedDirection * dot(unnormalizedDirection, directionDx)) /
        denominator;
    const vec3 rayDirectionDy =
        (squaredLength * directionDy -
         unnormalizedDirection * dot(unnormalizedDirection, directionDy)) /
        denominator;
    if (!isFiniteVector(rayDirectionDx) ||
        !isFiniteVector(rayDirectionDy)) {
        return 0.0;
    }

    const float planeDenominator = dot(rayDirection, shapeNormal);
    if (!isFiniteScalar(planeDenominator) ||
        abs(planeDenominator) <= positionDifferentialDenominatorMinimum) {
        return 0.0;
    }
    const float distanceDx =
        -dot(hitDistance * rayDirectionDx, shapeNormal) / planeDenominator;
    const float distanceDy =
        -dot(hitDistance * rayDirectionDy, shapeNormal) / planeDenominator;
    const vec3 positionDx =
        distanceDx * rayDirection + hitDistance * rayDirectionDx;
    const vec3 positionDy =
        distanceDy * rayDirection + hitDistance * rayDirectionDy;
    const vec2 uvDx = textureDerivative(primitiveId, positionDx);
    const vec2 uvDy = textureDerivative(primitiveId, positionDy);
    if (!isFiniteVector(uvDx) || !isFiniteVector(uvDy)) {
        return 0.0;
    }
    return 0.5 * (length(uvDx) + length(uvDy));
}

void main() {
    const uvec2 pixel = gl_GlobalInvocationID.xy;
    const uint width = parameters.extentAovAndReserved.x;
    const uint height = parameters.extentAovAndReserved.y;
    if (pixel.x >= width || pixel.y >= height) {
        return;
    }

    const uint outputIndex = pixel.y * width + pixel.x;
    const float imageX = float(pixel.x) - float(width) * 0.5;
    const float imageY = float(pixel.y) - float(height) * 0.5;
    const vec3 unnormalizedDirection =
        parameters.cameraDirectionAndRayMinimum.xyz +
        parameters.cameraPositionAndPixelScale.w *
            (imageX * parameters.cameraRightAndUnused.xyz +
             imageY * parameters.cameraUpAndUnused.xyz);
    const vec3 rayDirection = normalizedOrZero(unnormalizedDirection);
    if (dot(rayDirection, rayDirection) == 0.0) {
        outputBuffer.pixels[outputIndex] =
            vec4(0.0, 0.0, 0.0, 1.0);
        return;
    }

    const PackedTraceHit hit = tracePackedScene(
        parameters.cameraPositionAndPixelScale.xyz,
        parameters.cameraDirectionAndRayMinimum.w,
        rayDirection,
        rayMaximum,
        0U);
    if (!hit.hasHit) {
        outputBuffer.pixels[outputIndex] =
            vec4(0.0, 0.0, 0.0, 1.0);
        return;
    }

    const vec3 shapeNormal =
        triangleShapeNormal(hit.primitiveId, rayDirection);
    const uint aov = parameters.extentAovAndReserved.z;
    vec3 color = vec3(0.0);
    if (aov == primaryAovShapeNormal) {
        color = isFiniteVector(shapeNormal)
                    ? (shapeNormal + vec3(1.0)) * 0.5
                    : vec3(0.0);
    } else {
        const float footprint = primaryTextureFootprint(
            hit.primitiveId,
            hit.distance,
            unnormalizedDirection,
            rayDirection,
            shapeNormal);
        const vec3 baseColor =
            evaluateBaseColor(hit.primitiveId, hit.barycentrics, footprint);
        if (aov == primaryAovBaseColor) {
            color = baseColor;
        } else if (aov == primaryAovDirectDiffuse) {
            const float normalDotLight =
                dot(shapeNormal, parameters.directionToLightAndUnused.xyz);
            if (normalDotLight > 0.0) {
                const vec3 hitPosition =
                    parameters.cameraPositionAndPixelScale.xyz +
                    hit.distance * rayDirection;
                const PackedTraceHit shadowHit = tracePackedScene(
                    hitPosition,
                    parameters.cameraDirectionAndRayMinimum.w,
                    parameters.directionToLightAndUnused.xyz,
                    rayMaximum,
                    gl_RayFlagsTerminateOnFirstHitEXT);
                if (!shadowHit.hasHit) {
                    color =
                        max(baseColor, vec3(0.0)) *
                        parameters.incidentRadianceAndUnused.xyz *
                        (normalDotLight / pi);
                }
            }
        }
    }
    color = isFiniteVector(color) ? color : vec3(0.0);
    outputBuffer.pixels[outputIndex] = vec4(color, 1.0);
}

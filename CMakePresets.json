{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "environment": {
        "VSLANG": "1033"
      },
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_PREFIX_PATH": "$env{CONDA_PREFIX};$env{CONDA_PREFIX}/Library",
        "RAYM0NADE_BUILD_FXAA": "ON",
        "RAYM0NADE_BUILD_RENDERER": "ON",
        "RAYM0NADE_ENABLE_VULKAN": "OFF"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (Conda + Ninja)",
      "description": "Portable debug build for Windows, Linux, and macOS",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release (Conda + Ninja)",
      "description": "Portable optimized build for Windows, Linux, and macOS",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "gpu-debug",
      "displayName": "Debug with experimental Vulkan GPU backend",
      "description": "Debug build with the optional headless Vulkan Ray Query backend",
      "inherits": "debug",
      "cacheVariables": {
        "RAYM0NADE_ENABLE_VULKAN": "ON"
      }
    },
    {
      "name": "gpu-release",
      "displayName": "Release with experimental Vulkan GPU backend",
      "description": "Optimized build with the optional headless Vulkan Ray Query backend",
      "inherits": "release",
      "cacheVariables": {
        "RAYM0NADE_ENABLE_VULKAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "gpu-debug",
      "configurePreset": "gpu-debug"
    },
    {
      "name": "gpu-release",
      "configurePreset": "gpu-release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "gpu-debug",
      "configurePreset": "gpu-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "gpu-release",
      "configurePreset": "gpu-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "debug",
      "displayName": "Configure, build, and test Debug",
      "steps": [
        {
          "type": "configure",
          "name": "debug"
        },
        {
          "type": "build",
          "name": "debug"
        },
        {
          "type": "test",
          "name": "debug"
        }
      ]
    },
    {
      "name": "release",
      "displayName": "Configure, build, and test Release",
      "steps": [
        {
          "type": "configure",
          "name": "release"
        },
        {
          "type": "build",
          "name": "release"
        },
        {
          "type": "test",
          "name": "release"
        }
      ]
    }
  ]
}
